<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY (overrides src/main/res/xml/network_security_config.xml).
  Allows plain http:// so a phone can reach a dev backend on the PC's LAN IP
  (e.g. http://192.168.1.74:8000). Release builds keep the strict HTTPS-only config.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
