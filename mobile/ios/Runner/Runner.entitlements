<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Core NFC tag reading/writing ("NDEF" alone is no longer accepted by App Store Connect). -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!-- Tap links https://<host>/t/{code} open the app (apple-app-site-association served by the backend).
	     The host is NEXTAP_LINK_DOMAIN in Flutter/nexTap.xcconfig. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(NEXTAP_LINK_DOMAIN)</string>
	</array>
</dict>
</plist>
