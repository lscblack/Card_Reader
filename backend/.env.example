# ── Application ──────────────────────────────────────────────
APP_NAME=nexTap
ENVIRONMENT=development
DEBUG=true
API_BASE_URL=http://127.0.0.1:8000

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:YourStrongPassword@127.0.0.1:5432/nfc_platform
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YourStrongPassword
DB_NAME=nfc_platform

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-production-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── API keys ─────────────────────────────────────────────────
API_KEY_PREFIX=nfc_
API_KEY_LENGTH=48

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Webhooks ─────────────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3
WEBHOOK_SIGNING_SECRET=change-this-secret

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Email ────────────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_SMTP_SERVER=mail.example.com
EMAIL_SMTP_PORT=587
EMAIL_LOGIN=info@example.com
EMAIL_SENDER_EMAIL=info@example.com
EMAIL_SENDER_PASSWORD=YourEmailPassword
EMAIL_SENDER_NAME=nexTap

# ── Default admin ────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeThisImmediately
DEFAULT_ADMIN_NAME=Platform Administrator

# ── Optional extras (defaults shown; safe to omit) ───────────
# Auth endpoints (login/register/forgot/reset) limit per client IP.
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Run the delivery retry worker inside the API process. Set false when running
# `python -m app.workers.delivery` as a separate process.
DELIVERY_WORKER_ENABLED=true
# Trust X-Forwarded-For / X-Forwarded-Proto (only when behind a trusted TLS proxy).
TRUST_PROXY_HEADERS=false
# Reject non-HTTPS requests and send HSTS. Empty = true only when ENVIRONMENT=production.
ENFORCE_HTTPS=
# Dashboard page that handles password reset links (?token=... is appended).
PASSWORD_RESET_URL=http://localhost:5173/reset-password
LOG_LEVEL=INFO

# URL the nexTap app should use to reach this API (shown on the dashboard with a copy button).
# Use your PC's LAN IP in development, e.g. http://192.168.1.74:8000. Empty = API_BASE_URL.
DEVICE_SERVER_URL=

# ── Part 2: business accounts, sandbox, observability ────────
# Base for /t/{code} and /sandbox/{token}; empty = DEVICE_SERVER_URL or API_BASE_URL.
PUBLIC_API_URL=
# Base for /b/{slug}, /invite/{token}, /docs/errors (the web dashboard).
PUBLIC_WEB_URL=http://localhost:5173
# iOS app: card tap links (PUBLIC_API_URL/t/...) open the nexTap app (universal links). Set your Apple Developer
# Team ID (10 characters, developer.apple.com → Membership) to serve /.well-known/apple-app-site-association.
# Needs PUBLIC_API_URL on HTTPS with a valid certificate; the app's NEXTAP_LINK_DOMAIN must be that host.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=net.nexventures.nfc-terminal
MEDIA_ROOT=./media
# Demo developer + business accounts (only honoured when ENVIRONMENT=development).
SEED_DEMO_DATA=false
DEMO_PASSWORD=DemoPassword123
REQUEST_LOG_ENABLED=true
# Point a developer's first application at their auto-created sandbox endpoint.
SANDBOX_AUTO_ATTACH=true
# Admin email campaigns: max emails sent per minute by the worker.
EMAIL_THROTTLE_PER_MINUTE=120
# Swagger/ReDoc/OpenAPI endpoints (off by default in every environment).
API_DOCS_ENABLED=false

# ── Part 3: nexTap APK builds (admin → worker subprocess) ──
APP_BUILD_ENABLED=false
FLUTTER_BIN=/snap/bin/flutter
MOBILE_PROJECT_DIR=/path/to/Card_Reader/mobile
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# Optional; falls back to ANDROID_SDK_ROOT / ANDROID_HOME from the environment.
ANDROID_SDK_ROOT=
APP_BUILD_TIMEOUT_SECONDS=1800
